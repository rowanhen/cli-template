{
  "name": "my-cli",
  "version": "0.1.0",
  "description": "A CLI tool",
  "type": "module",
  "bin": {
    "my-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "check": "bun run lint && bun run format && bun run typecheck && bun run build && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@effect/cli": "^0.75.1",
    "@effect/platform": "^0.96.1",
    "@effect/platform-bun": "^0.89.0",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "oxlint": "^0.16.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.5"
}
